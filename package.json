{
  "name": "restosistem",
  "version": "1.0.0",
  "description": "Restosistem: sistema de gestión para restaurantes (monolito en capas) - Arquitectura de Software, Criterio 2 RdA 1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremyjacc/proyecto_drivers.git"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/persistence/database/migrate-cli.ts",
    "db:seed": "tsx src/persistence/database/seed-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
